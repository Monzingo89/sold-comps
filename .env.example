# Backend server settings
PORT=8787
CORS_ALLOW_ORIGIN=*

# eBay app credentials (production values shown as placeholders)
EBAY_APP_ID=YOUR_EBAY_APP_ID
EBAY_CLIENT_SECRET=YOUR_EBAY_CLIENT_SECRET
EBAY_ENVIRONMENT=production
EBAY_OAUTH_SCOPE=https://api.ebay.com/oauth/api_scope
EBAY_USER_SCOPE=https://api.ebay.com/oauth/api_scope
EBAY_RUNAME=YOUR_EBAY_RUNAME

# Optional OAuth redirect URLs for future user-login flows
AUTH_START_PATH=/api/ebay/connect
AUTH_ACCEPTED_URL=
AUTH_DECLINED_URL=
